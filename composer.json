{
    "name": "youvision/think-store-weather",
    "description": "ThinkPHP 8 天气查询组件：省市联动、上游天气 JSON 接口与 8 小时缓存。",
    "type": "library",
    "keywords": [
        "thinkphp",
        "weather",
        "layui",
        "api",
        "cache"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Youvision",
            "email": "dev@youvision.cn"
        }
    ],
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^8.0",
        "topthink/think-view": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkStoreWeather\\": "src/"
        }
    },

    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkStoreWeather\\Service"
            ],
            "config": {
                "store_weather": "config/store_weather.php"
            }
        },
        "store": {
            "home": "/store/think-store-weather/index"
        }
    },
    "scripts": {
        "test": "@php tests/verify.php"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

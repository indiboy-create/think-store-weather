{
    "name": "youvision/think-store-weather",
    "description": "ThinkPHP 8 天气查询组件：省市联动、上游天气 JSON 接口与 8 小时缓存。",
    "type": "library",
    "keywords": [
        "thinkphp",
        "weather",
        "layui",
        "api",
        "cache"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Youvision",
            "email": "dev@youvision.cn"
        }
    ],
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^8.0",
        "topthink/think-view": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkStoreWeather\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Youvision\\ThinkStoreWeather\\Tests\\": "tests/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkStoreWeather\\Service"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
